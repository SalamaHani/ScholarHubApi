generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String             @id @default(cuid())
  email                String             @unique
  password             String
  firstName            String
  lastName             String
  role                 UserRole           @default(STUDENT)
  avatar               String?
  phone                String?
  isEmailVerified      Boolean            @default(false)
  isActive             Boolean            @default(true)
  isBlocked            Boolean            @default(false)
  emailVerifyToken     String?
  emailVerifyExpires   DateTime?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  applications         Application[]
  notifications        Notification[]
  professorProfile     ProfessorProfile?
  refreshTokens        RefreshToken[]
  savedScholarships    SavedScholarship[]
  scholarships         Scholarship[]      @relation("CreatedBy")
  studentProfile       StudentProfile?
  testimonials         Testimonial[]

  @@index([email])
  @@index([role])
}

model StudentProfile {
  id                   String       @id @default(cuid())
  userId               String       @unique
  university           String?
  fieldOfStudy         String?
  currentDegree        DegreeLevel?
  gpa                  Float?
  graduationYear       Int?
  country              String?
  bio                  String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  documents            String[]
  age                  Int?
  gender               String?
  phoneNumber          String?
  skills               String[]
  city                 String?
  zipCode              String?
  profileCompleteness  Int          @default(0)
  averageLanguageLevel Int          @default(0)
  languages            Json?
  experience           Json?
  certifications       Json?
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProfessorProfile {
  id                   String    @id @default(cuid())
  userId               String    @unique
  institution          String
  department           String?
  position             String?
  specialization       String?
  website              String?
  bio                  String?
  isVerified           Boolean   @default(false)
  verifiedAt           DateTime?
  verifiedBy           String?
  verificationDocs     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  documents            String[]
  phoneNumber          String?
  skills               String[]
  city                 String?
  country              String?
  zipCode              String?
  profileCompleteness  Int       @default(0)
  averageLanguageLevel Int       @default(0)
  languages            Json?
  age                  Int?
  gender               String?
  experience           Json?
  certifications       Json?
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Scholarship {
  id              String                  @id @default(cuid())
  title           String
  description     String
  organization    String
  country         String
  region          String?
  fieldOfStudy    String[]
  degreeLevel     DegreeLevel[]
  fundingType     FundingType
  amount          Decimal?
  currency        String?
  deadline        DateTime
  startDate       DateTime?
  duration        String?
  applicationLink String
  requirements    String
  eligibility     String
  benefits        String?
  documents       String[]
  status          ScholarshipStatus       @default(PENDING_APPROVAL)
  isExternal      Boolean                 @default(false)
  isFeatured      Boolean                 @default(false)
  views           Int                     @default(0)
  createdById     String
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  language        String?
  studyMode       String?
  applications    Application[]
  categories      CategoryOnScholarship[]
  savedBy         SavedScholarship[]
  createdBy       User                    @relation("CreatedBy", fields: [createdById], references: [id])

  @@index([deadline])
  @@index([country])
  @@index([status])
  @@index([createdById])
}

model Category {
  id           String                  @id @default(cuid())
  name         String                  @unique
  slug         String                  @unique
  description  String?
  icon         String?
  color        String?
  isActive     Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  scholarships CategoryOnScholarship[]
}

model CategoryOnScholarship {
  scholarshipId String
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@id([scholarshipId, categoryId])
}

model Application {
  id              String            @id @default(cuid())
  userId          String
  scholarshipId   String
  status          ApplicationStatus @default(PENDING)
  coverLetter     String?
  documents       String[]
  additionalInfo  String?
  evaluationNotes String?
  evaluatedBy     String?
  evaluatedAt     DateTime?
  submittedAt     DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  scholarship     Scholarship       @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scholarshipId])
  @@index([userId])
  @@index([scholarshipId])
  @@index([status])
}

model SavedScholarship {
  id            String      @id @default(cuid())
  userId        String
  scholarshipId String
  notes         String?
  savedAt       DateTime    @default(now())
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scholarshipId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  isRead    Boolean   @default(false)
  repliedAt DateTime?
  createdAt DateTime  @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  author    String
  role      String
  image     String?
  gradient  String   @default("from-blue-400 to-indigo-600")
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  professor User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([createdBy])
  @@index([createdAt])
}

enum UserRole {
  STUDENT
  PROFESSOR
  ADMIN
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
  DRAFT
}

enum ScholarshipStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CLOSED
}

enum FundingType {
  FULL
  PARTIAL
  TUITION_ONLY
  STIPEND_ONLY
}

enum DegreeLevel {
  BACHELOR
  MASTER
  PHD
  POSTDOC
  RESEARCH
}

enum DocumentType {
  ID_CARD
  UNIVERSITY_CARD
  ACADEMIC_CERTIFICATE
  PASSPORT
  HIGH_DIPLOMA_CERTIFICATE
  BA_CERTIFICATE
  PHD_CERTIFICATE
  DATE_OF_BIRTH
  TRANSCRIPT
  RECOMMENDATION_LETTER
  MOTIVATION_LETTER
  CV
  TEACHING_CERTIFICATE
  RESEARCH_PUBLICATION
  PDF_FILE
  OTHER
}
