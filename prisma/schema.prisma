generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String             @id @default(cuid())
  email                String             @unique
  password             String?
  firstName            String
  lastName             String
  role                 UserRole           @default(STUDENT)
  avatar               String?
  phone                String?
  googleId             String?            @unique
  provider             String?            @default("local")
  isEmailVerified      Boolean            @default(false)
  isActive             Boolean            @default(true)
  isBlocked            Boolean            @default(false)
  emailVerifyToken     String?
  emailVerifyExpires   DateTime?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  applications         Application[]
  notifications        Notification[]
  professorProfile     ProfessorProfile?
  refreshTokens        RefreshToken[]
  savedScholarships    SavedScholarship[]
  scholarships         Scholarship[]      @relation("CreatedBy")
  studentProfile       StudentProfile?
  testimonials         Testimonial[]
  blogPosts            BlogPost[]           @relation("BlogPosts")
  @@index([email])
  @@index([googleId])
  @@index([role])
}

model StudentProfile {
  id                   String       @id @default(cuid())
  userId               String       @unique
  university           String?
  fieldOfStudy         String?
  currentDegree        DegreeLevel?
  gpa                  Float?
  graduationYear       Int?
  country              String?
  bio                  String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  documents            String[]
  age                  Int?
  gender               String?
  phoneNumber          String?
  skills               String[]
  city                 String?
  zipCode              String?
  profileCompleteness  Int          @default(0)
  averageLanguageLevel Int          @default(0)
  languages            Json?
  experience           Json?
  certifications       Json?
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProfessorProfile {
  id                   String    @id @default(cuid())
  userId               String    @unique
  institution          String
  department           String?
  position             String?
  specialization       String?
  website              String?
  bio                  String?
  isVerified           Boolean   @default(false)
  verifiedAt           DateTime?
  verifiedBy           String?
  verificationDocs     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  documents            String[]
  phoneNumber          String?
  skills               String[]
  city                 String?
  country              String?
  zipCode              String?
  profileCompleteness  Int       @default(0)
  averageLanguageLevel Int       @default(0)
  languages            Json?
  age                  Int?
  gender               String?
  experience           Json?
  certifications       Json?
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Scholarship {
  id              String                  @id @default(cuid())
  title           String
  description     String
  organization    String
  country         String
  region          String?
  fieldOfStudy    String[]
  degreeLevel     DegreeLevel[]
  fundingType     FundingType
  amount          Decimal?
  currency        String?
  deadline        DateTime
  startDate       DateTime?
  duration        String?
  applicationLink String
  requirements    String
  eligibility     String
  benefits        String?
  documents       String[]
  status          ScholarshipStatus       @default(PENDING_APPROVAL)
  isExternal      Boolean                 @default(false)
  isFeatured      Boolean                 @default(false)
  views           Int                     @default(0)
  createdById     String
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  language        String?
  studyMode       String?
  applications    Application[]
  categories      CategoryOnScholarship[]
  questions       ScholarshipQuestion[]
  savedBy         SavedScholarship[]
  createdBy       User                    @relation("CreatedBy", fields: [createdById], references: [id])

  @@index([deadline])
  @@index([country])
  @@index([status])
  @@index([createdById])
}

model Category {
  id           String                  @id @default(cuid())
  name         String                  @unique
  slug         String                  @unique
  description  String?
  icon         String?
  color        String?
  isActive     Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  scholarships CategoryOnScholarship[]
}

model CategoryOnScholarship {
  scholarshipId String
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@id([scholarshipId, categoryId])
}

model Application {
  id              String            @id @default(cuid())
  userId          String
  scholarshipId   String
  status          ApplicationStatus @default(PENDING)
  coverLetter     String?
  documents       String[]
  additionalInfo  String?
  evaluationNotes String?
  evaluatedBy     String?
  evaluatedAt     DateTime?
  submittedAt     DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  scholarship     Scholarship       @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers         ApplicationAnswer[]
  interview       Interview?
  @@unique([userId, scholarshipId])
  @@index([userId])
  @@index([scholarshipId])
  @@index([status])
}

model Interview {
  id            String          @id @default(cuid())
  applicationId String          @unique
  scheduledAt   DateTime
  platform      InterviewPlatform @default(OTHER)
  meetingLink   String?
  location      String?
  notes         String?
  duration      Int             @default(60)
  status        InterviewStatus @default(SCHEDULED)
  cancelReason  String?
  scheduledBy   String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([scheduledAt])
  @@index([status])
}

model SavedScholarship {
  id            String      @id @default(cuid())
  userId        String
  scholarshipId String
  notes         String?
  savedAt       DateTime    @default(now())
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scholarshipId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  isRead    Boolean   @default(false)
  repliedAt DateTime?
  createdAt DateTime  @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  author    String
  role      String
  image     String?
  gradient  String   @default("from-blue-400 to-indigo-600")
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  professor User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([createdBy])
  @@index([createdAt])
}

enum UserRole {
  STUDENT
  PROFESSOR
  ADMIN
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  INTERVIEW_SCHEDULED
  ACCEPTED
  REJECTED
  WITHDRAWN
  DRAFT
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InterviewPlatform {
  ZOOM
  GOOGLE_MEET
  MICROSOFT_TEAMS
  SKYPE
  IN_PERSON
  PHONE
  OTHER
}

enum ScholarshipStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CLOSED
}

enum FundingType {
  FULL
  PARTIAL
  TUITION_ONLY
  STIPEND_ONLY
}

enum DegreeLevel {
  BACHELOR
  MASTER
  PHD
  POSTDOC
  RESEARCH
}

enum QuestionType {
  TEXT
  MULTIPLE_CHOICE
  DOCUMENT
}

enum DocumentType {
  ID_CARD
  UNIVERSITY_CARD
  ACADEMIC_CERTIFICATE
  PASSPORT
  HIGH_DIPLOMA_CERTIFICATE
  BA_CERTIFICATE
  PHD_CERTIFICATE
  DATE_OF_BIRTH
  TRANSCRIPT
  RECOMMENDATION_LETTER
  MOTIVATION_LETTER
  CV
  TEACHING_CERTIFICATE
  RESEARCH_PUBLICATION
  PDF_FILE
  OTHER
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Settings {
  id Int @id @default(1)

  // Platform / General
  defaultLanguage          String  @default("ar")
  timezone                 String  @default("Asia/Gaza")
  registrationEnabled      Boolean @default(true)
  requireEmailVerification Boolean @default(true)
  maxFileSizeMB            Int     @default(10)
  allowedFileTypes         String[] // e.g. ["pdf","jpg","png","docx"]

  // Site Settings
  siteName            String  @default("ScholarHub")
  siteDescription     String  @default("Your scholarship discovery platform")
  siteLogoUrl         String?
  siteFaviconUrl      String?
  contactEmail        String  @default("admin@scholarhub.com")
  supportEmail        String?
  supportPhone        String?
  maintenanceMode     Boolean @default(false)
  maintenanceMessage  String  @default("We are currently under maintenance. Please check back soon.")

  // Address / Location
  address    String?
  city       String?
  country    String?

  // Social Media Links
  facebookUrl   String?
  twitterUrl    String?
  linkedinUrl   String?
  instagramUrl  String?
  youtubeUrl    String?

  // Branding / Colors
  primaryColor   String @default("#3B82F6")
  secondaryColor String @default("#1E40AF")
  accentColor    String @default("#F59E0B")
  textColor      String @default("#111827")
  bgColor        String @default("#FFFFFF")
  darkPrimaryColor   String @default("#60A5FA")
  darkBgColor        String @default("#0F172A")

  // Default / External Links
  homeUrl           String @default("/")
  privacyPolicyUrl  String @default("/privacy-policy")
  termsUrl          String @default("/terms-of-service")
  cookiePolicyUrl   String @default("/cookies")
  appStoreUrl       String?
  playStoreUrl      String?
  docsUrl           String?

  // SEO Settings
  metaTitle         String?
  metaDescription   String?
  googleAnalyticsId String?
  ogTitle           String?
  ogDescription     String?
  ogImageUrl        String?
  twitterCard       String @default("summary_large_image")
  robotsMeta        String @default("index, follow")
  canonicalUrl      String?

  // Footer
  footerText    String?
  copyrightText String @default("© 2026 ScholarHub. All rights reserved.")

  // Scholarship Settings
  autoApproveScholarships  Boolean @default(false)
  maxScholarshipsPerProf   Int     @default(10)
  featuredScholarshipLimit Int     @default(6)
  requireApprovalForEdit   Boolean @default(true)

  // Application Settings
  maxApplicationsPerStudent Int     @default(5)
  allowWithdrawal           Boolean @default(true)
  deadlineBufferDays        Int     @default(3)
  allowDraftApplications    Boolean @default(true)

  // Notification Settings
  emailNotificationsEnabled   Boolean @default(true)
  pushNotificationsEnabled    Boolean @default(true)
  deadlineReminderDays        Int     @default(7)
  notifyAdminOnNewScholarship Boolean @default(true)
  notifyAdminOnNewApplication Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScholarshipQuestion {
  id            String              @id @default(cuid())
  scholarshipId String
  question      String
  type          QuestionType        @default(TEXT)
  options       String[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  scholarship   Scholarship         @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  answers       ApplicationAnswer[]
  @@index([scholarshipId])
}

model ApplicationAnswer {
  id            String              @id @default(cuid())
  applicationId String
  questionId    String
  answer        String?
  attachmentId  String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  application   Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question      ScholarshipQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([questionId])
}

model PageContent {
  id          String   @id @default(cuid())
  pageKey     String   @unique
  section     String
  title       String
  subtitle    String?
  description String?
  heroText    String?
  ctaLabel    String?
  ctaLink     String?
  metaData    Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([pageKey])
  @@index([section])
}

model FaqItem {
  id        String   @id @default(cuid())
  pageKey   String
  question  String
  answer    String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageKey])
  @@index([order])
}

model BlogPost {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  excerpt     String?
  content     String
  coverImage  String?
  authorName  String
  authorId    String
  tags        String[]
  status      BlogPostStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  author      User           @relation("BlogPosts", fields: [authorId], references: [id])

  @@index([slug])
  @@index([status])
  @@index([authorId])
  @@index([publishedAt])
}
